---
// Instagram wall via Behold (https://behold.so) — fetched at build time,
// so the strip refreshes on every deploy. If the feed is unreachable or
// empty, the section renders nothing; the build never fails because of it.
const FEED_URL = 'https://feeds.behold.so/quJmS6HXuZ24VsxOMn5d';
const MAX_POSTS = 6;

interface BeholdSize {
  mediaUrl: string;
  width: number;
  height: number;
}

interface BeholdPost {
  id: string;
  permalink: string;
  mediaType: 'IMAGE' | 'VIDEO' | 'CAROUSEL_ALBUM';
  mediaUrl: string;
  thumbnailUrl?: string;
  prunedCaption?: string;
  isReel?: boolean;
  sizes?: { small?: BeholdSize; medium?: BeholdSize; large?: BeholdSize; full?: BeholdSize };
}

let username = 'ciseldsouza';
let posts: BeholdPost[] = [];
try {
  const res = await fetch(FEED_URL);
  if (res.ok) {
    const feed = await res.json();
    username = feed.username ?? username;
    posts = (feed.posts ?? []).slice(0, MAX_POSTS);
  } else {
    console.warn(`[InstaStrip] Behold feed responded ${res.status} — strip hidden this build.`);
  }
} catch (err) {
  console.warn('[InstaStrip] Behold feed unreachable — strip hidden this build.', err);
}

function imageOf(post: BeholdPost): BeholdSize | undefined {
  if (post.sizes?.medium) return post.sizes.medium;
  const url = post.mediaType === 'VIDEO' ? post.thumbnailUrl : post.mediaUrl;
  return url ? { mediaUrl: url, width: 640, height: 640 } : undefined;
}

const items = posts
  .map((post) => ({ post, img: imageOf(post) }))
  .filter((i): i is { post: BeholdPost; img: BeholdSize } => Boolean(i.img));
---
{items.length > 0 && (
  <section class="border-t border-line px-6 py-12 md:px-12 md:py-16">
    <div class="mb-6 flex items-baseline justify-between" data-reveal>
      <h2 class="font-display font-bold text-2xl text-bone md:text-3xl">from <span class="text-butter">instagram</span></h2>
      <a href={`https://instagram.com/${username}`} target="_blank" rel="noopener" class="u-link text-[0.7rem] tracking-[0.2em] uppercase text-muted hover:text-bone focus-visible:text-bone transition-colors">@{username} <span aria-hidden="true">→</span></a>
    </div>
    <div class="ig-grid grid grid-cols-2 gap-0.5 sm:grid-cols-3" style={`--ig-cols:${items.length}`}>
      {items.map(({ post, img }, i) => (
        <a
          href={post.permalink}
          target="_blank"
          rel="noopener"
          class="group/ig relative block aspect-square overflow-hidden"
          data-reveal
          style={`transition-delay:${i * 90}ms`}
        >
          <img
            src={img.mediaUrl}
            alt={post.prunedCaption ? post.prunedCaption.slice(0, 120) : `Instagram post by @${username}`}
            width={img.width}
            height={img.height}
            loading="lazy"
            class="h-full w-full object-cover brightness-[.88] saturate-[.8] transition duration-500 ease-out group-hover/ig:scale-[1.05] group-hover/ig:brightness-100 group-hover/ig:saturate-100 group-focus-visible/ig:scale-[1.05] group-focus-visible/ig:brightness-100 group-focus-visible/ig:saturate-100"
          />
          <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-charcoal/80 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover/ig:opacity-100 group-focus-visible/ig:opacity-100" aria-hidden="true"></span>
          <span class="pointer-events-none absolute inset-x-3 bottom-2.5 flex translate-y-1 items-center justify-between gap-2 opacity-0 transition duration-300 group-hover/ig:translate-y-0 group-hover/ig:opacity-100 group-focus-visible/ig:translate-y-0 group-focus-visible/ig:opacity-100">
            <span class="truncate text-[0.65rem] tracking-[0.08em] text-bone/90">{post.prunedCaption ? post.prunedCaption.slice(0, 60) : `@${username}`}</span>
            <span class="text-butter" aria-hidden="true">↗</span>
          </span>
          {(post.mediaType === 'VIDEO' || post.isReel) && (
            <span class="absolute right-2.5 top-2.5 text-xs text-bone/90 drop-shadow" aria-hidden="true">▶</span>
          )}
        </a>
      ))}
    </div>
  </section>
)}
