---
import Capture from './Capture.astro';
---
<section class="border-t border-line px-6 py-20 text-center md:px-12 md:py-28">
  <h2
    class="font-display font-bold lowercase leading-[1.05] tracking-[-0.02em] text-[clamp(2.25rem,6vw,4.25rem)]"
