---
interface Props {
  showLabel?: boolean;
}
const { showLabel = true } = Astro.props;
---
<div class="max-w-md text-left" data-capture-wrap data-reveal>
  {showLabel && <p class="font-serif text-xl text-bone mb-1">the decode, in your inbox</p>}
  <form
    method="POST"
    name="decode-signup"
    data-netlify="true"
    netlify-honeypot="bot-field"
    data-capture
    class="group flex items-baseline gap-3 border-b border-faint pb-2 transition-colors focus-within:border-butter"
  >
    <input type="hidden" name="form-name" value="decode-signup" />
    <p class="hidden" aria-hidden="true">
      <label>don't fill this out if you're human: <input name="bot-field" /></label>
    </p>
    <input
      type="email"
      name="email"
      required
      placeholder="your@email.com"
      autocomplete="email"
      aria-label="email address"
      class="w-full bg-transparent font-body text-sm font-light text-bone placeholder:text-faint outline-none focus-visible:outline-solid focus-visible:outline-offset-4 focus-visible:outline-butter/50"
    />
    <button type="submit" class="shrink-0 text-[0.65rem] tracking-[0.2em] uppercase text-butter cursor-pointer">
      get the decode <span aria-hidden="true">→</span>
    </button>
  </form>
  <p class="mt-2 text-[0.7rem] tracking-[0.04em] text-faint" data-note>one decode a week. no spam.</p>
  <p class="mt-2 font-serif text-sm text-butter" data-success hidden role="status">you're in — the next decode lands in your inbox.</p>
  <p class="mt-2 text-[0.65rem] tracking-[0.04em] text-butter" data-error hidden role="alert">something went wrong — please try again.</p>
</div>

<script>
  function initCapture() {
    document.querySelectorAll<HTMLFormElement>('[data-capture]').forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = 'true';
      const wrap = form.closest<HTMLElement>('[data-capture-wrap]')!;
      const note = wrap.querySelector<HTMLElement>('[data-note]')!;
      const success = wrap.querySelector<HTMLElement>('[data-success]')!;
      const error = wrap.querySelector<HTMLElement>('[data-error]')!;
      let pending = false;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (pending) return;
        pending = true;
        error.hidden = true;
        const body = new URLSearchParams(
          new FormData(form) as unknown as Record<string, string>
        ).toString();
        fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        })
          .then((res) => {
            if (!res.ok) throw new Error(`form post failed: ${res.status}`);
            form.hidden = true;
            note.hidden = true;
            success.hidden = false;
          })
          .catch(() => {
            error.hidden = false;
          })
          .finally(() => {
            pending = false;
          });
      });
    });
  }
  // rebind after view-transition navigations; fires on initial load too
  document.addEventListener('astro:page-load', initCapture);
</script>
