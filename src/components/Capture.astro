<div class="max-w-md" data-reveal>
  <p class="font-serif italic text-lg text-bone mb-1">be the first to know when i launch</p>
  <form
    method="POST"
    action="https://docs.google.com/forms/d/e/1FAIpQLSfN8VW8dOFFSNBKRwaWBfcNBKXVIDjpQ82DxEApX68iMgsXHQ/formResponse"
    target="_blank"
    data-capture
    class="group flex items-baseline gap-3 border-b border-faint pb-2 transition-colors focus-within:border-champagne"
  >
    <input
      type="email"
      name="entry.1485403170"
      required
      placeholder="your@email.com"
      autocomplete="email"
      aria-label="email address"
      class="w-full bg-transparent font-body text-sm font-light text-bone placeholder:text-faint outline-none focus-visible:outline focus-visible:outline-offset-4 focus-visible:outline-champagne/50"
    />
    <button type="submit" class="shrink-0 text-[0.65rem] tracking-[0.2em] uppercase text-champagne cursor-pointer">
      notify me <span aria-hidden="true">→</span>
    </button>
  </form>
  <p class="mt-2 text-[0.65rem] tracking-[0.04em] text-faint" data-note>no spam. just the launch announcement.</p>
  <p class="mt-2 font-serif italic text-sm text-champagne" data-success hidden role="status">you're on the list. talk soon.</p>
  <p class="mt-2 text-[0.65rem] tracking-[0.04em] text-champagne" data-error hidden role="alert">something went wrong — please try again.</p>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-capture]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const note = document.querySelector<HTMLElement>('[data-note]')!;
    const success = document.querySelector<HTMLElement>('[data-success]')!;
    const error = document.querySelector<HTMLElement>('[data-error]')!;
    error.hidden = true;
    fetch(form.action, { method: 'POST', mode: 'no-cors', body: new FormData(form) })
      .then(() => {
        form.hidden = true;
        note.hidden = true;
        success.hidden = false;
      })
      .catch(() => {
        error.hidden = false;
      });
  });
</script>
