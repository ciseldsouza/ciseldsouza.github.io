<div class="max-w-md" data-reveal>
  <p class="font-serif italic text-lg text-bone mb-1">be the first to know when i launch</p>
  <form
    method="POST"
    name="launch-notify"
    data-netlify="true"
    netlify-honeypot="bot-field"
    data-capture
    class="group flex items-baseline gap-3 border-b border-faint pb-2 transition-colors focus-within:border-champagne"
  >
    <input type="hidden" name="form-name" value="launch-notify" />
    <p class="hidden" aria-hidden="true">
      <label>don't fill this out if you're human: <input name="bot-field" /></label>
    </p>
    <input
      type="email"
      name="email"
      required
      placeholder="your@email.com"
      autocomplete="email"
      aria-label="email address"
      class="w-full bg-transparent font-body text-sm font-light text-bone placeholder:text-faint outline-none focus-visible:outline-solid focus-visible:outline-offset-4 focus-visible:outline-champagne/50"
    />
    <button type="submit" class="shrink-0 text-[0.65rem] tracking-[0.2em] uppercase text-champagne cursor-pointer">
      notify me <span aria-hidden="true">→</span>
    </button>
  </form>
  <p class="mt-2 text-[0.65rem] tracking-[0.04em] text-faint" data-note>no spam. just the launch announcement.</p>
  <p class="mt-2 font-serif italic text-sm text-champagne" data-success hidden role="status">you're on the list. talk soon.</p>
  <p class="mt-2 text-[0.65rem] tracking-[0.04em] text-champagne" data-error hidden role="alert">something went wrong — please try again.</p>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-capture]');
  let pending = false;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (pending) return;
    pending = true;
    const note = document.querySelector<HTMLElement>('[data-note]')!;
    const success = document.querySelector<HTMLElement>('[data-success]')!;
    const error = document.querySelector<HTMLElement>('[data-error]')!;
    error.hidden = true;
    const body = new URLSearchParams(
      new FormData(form) as unknown as Record<string, string>
    ).toString();
    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body,
    })
      .then((res) => {
        if (!res.ok) throw new Error(`form post failed: ${res.status}`);
        form.hidden = true;
        note.hidden = true;
        success.hidden = false;
      })
      .catch(() => {
        error.hidden = false;
      })
      .finally(() => {
        pending = false;
      });
  });
</script>
