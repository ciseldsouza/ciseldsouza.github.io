---
const items = ['strategy', 'brand', 'ecommerce', 'growth', 'marketing'];
const line = items.map((i) => `${i} · `).join('');
---
<div class="overflow-hidden border-y border-line py-4" aria-hidden="true">
  <div class="marquee-track flex w-max whitespace-nowrap font-display text-xs font-medium uppercase tracking-[0.14em] text-faint">
    <span>{line.repeat(4)}</span>
    <span>{line.repeat(4)}</span>
  </div>
</div>
