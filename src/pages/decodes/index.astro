---
import Layout from '../../layouts/Layout.astro';
import JournalRow from '../../components/JournalRow.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
---
<Layout title="the decodes — cisel dsouza" description="Weekly breakdowns of the marketing, branding and psychology behind the brands everyone's talking about.">
  <section class="px-6 pt-16 pb-12 md:px-12 md:pt-24">
    <h1 class="font-display font-bold lowercase leading-none tracking-[-0.02em] text-[clamp(2.5rem,6vw,4.5rem)]" data-reveal>
      the <em class="not-italic text-butter">decodes</em>
    </h1>
    <p class="mt-6 max-w-md text-base font-light leading-relaxed text-muted" data-reveal>
      the marketing, branding and psychology behind the brands everyone's talking about — one decode a week.
    </p>
  </section>
  <section class="px-6 pb-16 md:px-12">
    <div class="border-t border-line">
      {posts.map((post, i) => <JournalRow post={post} index={i} />)}
    </div>
  </section>
  <CtaBand />
</Layout>
