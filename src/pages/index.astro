---
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';
import JournalRow from '../components/JournalRow.astro';
import { getPublishedPosts } from '../utils/posts';

const posts = (await getPublishedPosts()).slice(0, 3);
---
<Layout
  title="cisel dsouza | Let's talk marketing &amp; branding."
  description="I'm Cisel. I decode the marketing, branding and psychology behind the brands everyone's talking about. New decode every month."
>
  <section class="px-6 pt-16 pb-12 text-center md:px-12 md:pt-24 md:pb-16">
    <h1 class="font-display font-semibold lowercase leading-[1.02] tracking-[-0.02em] text-[clamp(2.5rem,6.5vw,5.5rem)]" data-reveal>
      Let's talk<br />marketing <em class="font-accent italic font-normal text-butter">&amp;</em> branding.
    </h1>
    <p class="mx-auto mt-8 max-w-md text-base font-light leading-relaxed text-muted" data-reveal>
      I'm Cisel. I decode the marketing, branding and psychology behind the brands
      everyone's talking about.
    </p>
    <div class="mt-12 flex flex-wrap justify-center gap-4" data-reveal>
      <a
        href="/decodes/"
        class="inline-block border border-bone bg-bone px-8 py-3 font-display text-[0.7rem] font-medium tracking-[0.14em] uppercase text-charcoal transition-opacity hover:opacity-75 focus-visible:opacity-75"
      >
        Read the decodes
      </a>
      <a
        href="https://instagram.com/ciseldsouza"
        target="_blank"
        rel="noopener"
        class="inline-block border border-faint px-8 py-3 font-display text-[0.7rem] font-medium tracking-[0.14em] uppercase text-bone transition-opacity hover:opacity-75 focus-visible:opacity-75"
      >
        Follow on Instagram
      </a>
    </div>
  </section>

  <Marquee />

  <section class="px-6 py-12 md:px-12 md:py-16">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <h2 class="font-display font-bold text-3xl text-bone md:text-4xl">the <em class="not-italic text-butter">decodes</em></h2>
        <p class="mt-2 max-w-sm text-base font-light leading-relaxed text-muted">
          monthly breakdowns of the marketing, branding and psychology behind brands you know.
        </p>
      </div>
      <a href="/decodes/" class="u-link text-[0.7rem] tracking-[0.2em] uppercase text-muted hover:text-bone focus-visible:text-bone transition-colors">all decodes <span aria-hidden="true">→</span></a>
    </div>
    <div class="border-t border-line">
      {posts.map((post, i) => <JournalRow post={post} index={i} />)}
    </div>
  </section>

  <section class="grid border-t border-line md:grid-cols-2">
    <div class="border-b border-line px-6 py-10 md:border-b-0 md:border-r md:px-12" data-reveal>
      <h2 class="sec-label mb-5">services</h2>
      <ul class="font-serif text-xl leading-loose text-bone">
        <li>brand strategy</li>
        <li>marketing</li>
        <li>ecommerce</li>
        <li>growth</li>
      </ul>
    </div>
    <div class="px-6 py-10 md:px-12" data-reveal>
      <h2 class="sec-label mb-5">elsewhere</h2>
      <p class="max-w-xs text-sm font-light leading-relaxed text-muted">
        daily thinking, behind the scenes, and work in progress.
        <a href="https://instagram.com/ciseldsouza" target="_blank" rel="noopener" class="u-link text-bone">@ciseldsouza</a>
      </p>
    </div>
  </section>

</Layout>
